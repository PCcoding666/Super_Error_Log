  {"op": "shot", "feature": "item-detail", "name": "discarded", "entry": "detail-discard", "note": "detail discard returned to the notebook and the question is gone"},

  {"op": "profile", "name": "android"},
  {"op": "open", "path": "/s/"},
  {"op": "wait", "testid": "next-step-primary", "timeout": 20000},
  {"op": "click", "testid": "next-step-primary"},
  {"op": "wait", "testid": "capture-mode-sheet"},
  {"op": "tap-file", "testid": "capture-mode-single"},
  {"op": "wait", "text": "打不开相册", "timeout": 8000},
  {"op": "click", "testid": "capture-mode-cancel"},
  {"op": "wait", "testid": "capture-mode-sheet", "state": "hidden", "timeout": 5000},
  {"op": "shot", "feature": "capture", "name": "blocked-chooser", "entry": "android-shell"},
  {"op": "click", "role": "button", "name": "知道了"},
  {"op": "wait", "text": "打不开相册", "state": "hidden", "timeout": 5000},

  {"op": "skip", "feature": "item-detail", "entry": "detail-discard-undo", "blocker": "Discard on the detail screen navigates back and does not show 撤销. Undo is only offered when removal starts on the notebook, which the select and swipe steps already restore."},
  {"op": "skip", "feature": "notebook", "entry": "load-error", "blocker": "This fixture has no fault switch for a failed notebook request."},
  {"op": "skip", "feature": "intake", "entry": "retry", "blocker": "This fixture does not inject a failed upload or a failed read."},
  {"op": "skip", "feature": "item-detail", "entry": "voice", "blocker": "Microphone permission is not granted, so a transcript cannot be produced."},
  {"op": "skip", "feature": "choose-stage", "entry": "ionic-gate", "blocker": "First login renders the server stage page, not the Ionic stage-gate."}
