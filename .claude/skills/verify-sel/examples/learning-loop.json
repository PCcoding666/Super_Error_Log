  {"op": "files", "testid": "answer-photo-input"},
  {"op": "wait", "text": "答案照片收到了", "timeout": 20000},
  {"op": "wait", "testid": "answer-photo-add", "text": "已录 1 张", "timeout": 20000},
  {"op": "shot", "feature": "item-detail", "name": "answer-photo", "entry": "answer-photo"},

  {"op": "click", "testid": "discard"},
