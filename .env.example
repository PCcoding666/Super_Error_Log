# Super Error Log 环境变量示例
# 复制为 .env，在本机填写密钥；不要将 .env 提交或把密钥发到聊天中。

# 服务端口（默认 3100）
PORT=3100

# 真实资料与演示数据分开保存（含 SQLite、照片、图示、PDF）
SEL_DATA_DIR=data/real

# bailian：百炼官方服务；openai：其他兼容服务；mock：显式本地演示
SEL_AI_MODE=bailian

# 北京；如使用新加坡，改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 密钥必须与地域匹配。缺配置直接报错，绝不自动降级成 Mock。
SEL_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEL_AI_API_KEY=
SEL_AI_MODEL=qwen3.8-27b

# 留空则沿用 SEL_AI_MODEL；实测后再分别选定，不预设哪个模型最好。
SEL_AI_MODEL_LAYOUT=
SEL_AI_MODEL_TRANSCRIBE=
SEL_AI_MODEL_DIAGNOSE=
SEL_AI_MODEL_COACH=
SEL_AI_MODEL_MATCH=
SEL_AI_MODEL_CROP_INVENTORY=
SEL_AI_MODEL_CROP_VERIFY=

# 学生网页版「说说为什么错」的语音转写（只走百炼北京接口；不沿用 SEL_AI_MODEL，文本模型不能转写）。留空用 qwen-audio-3.1-asr-flash
# （走百炼原生 multimodal-generation 接口，地址写死在代码里；SEL_AI_API_KEY 要有该模型的调用权限）。
SEL_AI_MODEL_ASR=

# AI 调用超时（毫秒）
SEL_AI_TIMEOUT_MS=90000

# 故障注入（仅 mock 模式，用于演练降级路径）：timeout 或 invalid_json
SEL_MOCK_FAULT=

# 手机网页版：每个学生一个邀请码与独立数据空间（受控试用最多3个）。
# 关闭时保留已有设备码网页登录；仅当前轮发布显式开启。
SEL_STUDENT_HOST_ENABLED=0
# 不设置时为 SEL_MOBILE_DATA_DIR/student-host；与旧原生App数据分开。
# SEL_STUDENT_HOST_DIR=/var/lib/super-error-log/student-host
