# /etc/super-error-log/ops.env —— 运维脚本配置（root:root 0644，里面不放任何密钥）。
# 推送 key 放 /etc/super-error-log/alert.env（root:root 0600），见文件末尾。

# 数据目录与学生网关目录
SEL_OPS_DATA_DIR=/var/lib/super-error-log
# SEL_OPS_HOST_DIR=/var/lib/super-error-log/student-host

# 每日备份
SEL_BACKUP_DIR=/var/backups/super-error-log-daily
SEL_BACKUP_KEEP_DAYS=14
# 异地目标三选一：
#   oss://<桶名>/super-error-log            （ossutil 凭据在 root 的 ~/.ossutilconfig；桶开服务端加密 + 14 天生命周期）
#   rsync:backup@<另一台主机>:/srv/sel-backup  （root 的 ~/.ssh 里放专用私钥；对方 authorized_keys 限制为 rsync）
#   none                                       （不推送；巡检每次都会提醒）
SEL_BACKUP_REMOTE=none
# SEL_OSSUTIL=/usr/local/bin/ossutil
# SEL_RSYNC=/usr/bin/rsync

# 巡检
SEL_OPS_PUBLIC_HOST=study.pccoding666.com
SEL_OPS_CONNECT_HOST=127.0.0.1
SEL_OPS_STATE_DIR=/var/lib/sel-ops
# 跳过某些检查（逗号分隔）：systemd,http,journal,cert,backup。还没装每日备份时写 backup，否则每小时都会提醒「没有备份」。
# SEL_OPS_SKIP=backup
# 阈值（缺省值如下）
# SEL_ALERT_DISK_MIN_GIB=4
# SEL_ALERT_DISK_MAX_PCT=85
# SEL_ALERT_QUEUE_MAX=30
# SEL_ALERT_AI_FAIL_PCT=20
# SEL_ALERT_AI_MIN_CALLS=5
# SEL_ALERT_FALLBACK_PER_HOUR=10
# SEL_ALERT_CERT_DAYS=20
# SEL_ALERT_BACKUP_MAX_AGE_H=26
# SEL_ALERT_UPSTREAM_ERRORS=0
# SEL_ALERT_REPEAT_MIN=60
# 实时人数（网关每 15 秒写 student-host/live-status.json）：
#   最近 5 分钟有几位同学因为错题本名额满进不去就提醒（0 = 不提醒）
# SEL_ALERT_REJECTED_STUDENTS=1
#   最近 5 分钟 AI 排队最多几件就提醒（0 = 不提醒）
# SEL_ALERT_AI_WAITING=10
#   实时数据几分钟没更新就提醒
# SEL_ALERT_LIVE_STALE_MIN=3

# ---- /etc/super-error-log/alert.env（单独文件，root:root 0600）----
# 二选一或都填：
# SEL_ALERT_BARK_KEY=<Bark App「服务」页推送链接 https://api.day.app/<key>/ 中间那段，不是设置页的 Device Token>
# SEL_ALERT_BARK_SERVER=https://api.day.app
# SEL_ALERT_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<群机器人 key>
