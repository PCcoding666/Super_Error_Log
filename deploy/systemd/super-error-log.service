# Super Error Log 主服务（含受控学生网页版）
# 主进程提供 /v1、/v2 原生手机接口和 /s/ 网页入口；学生空间启用后由独立子进程处理。
# 仅 /s/ 为学生网页，/、/parent、/items、/trends 旧页面不公开。
# 目标机：广州 ECS（239），systemd 230+，cgroup v1
# 管理说明见 deploy/README.md；改本文件后 systemctl daemon-reload。

[Unit]
Description=Super Error Log mobile API and student web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 专用低权限用户（无登录 shell、无家目录写入；由部署脚本创建）。
User=supererrorlog
Group=supererrorlog

# 受控发布目录内锁定的 Node 24 LTS 绝对路径——不使用 /usr/bin/node。
# /opt/super-error-log/current 是指向 releases/<版号> 的软链（回滚=切链）。
# v2.0 T2 起入口为 dist/main.js（单进程装配；旧的 dist/mobile/server.js 仅保留给开发调试）。
ExecStart=/opt/super-error-log/node-v24/bin/node /opt/super-error-log/current/dist/main.js

# 密钥只进 EnvironmentFile（0600 root:root），不进单元文件、不进命令行。
EnvironmentFile=/etc/super-error-log/env
# 进程标题与崩溃转储中不含用户照片/密钥。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/super-error-log

# 资源限制。systemd 239 / cgroup v1 同时写 MemoryMax 与 MemoryLimit（v1 读的是后者），两处保持相同数值。
# 推荐档：4 核 / 8 GB 机器。MemoryMax=4G，CPUQuota=300%（3 核）。父子进程和所有学生 worker 共用这一份。
# 当前广州小机是 2 核 / 1.8 GB，不能直接用 4G。先装
# deploy/systemd/super-error-log.service.d/small-box.conf（MemoryMax=1G、CPUQuota=150%），
# 再把环境改成 SEL_SERVICE_MEMORY_MIB=1024、SEL_MAX_LIVE_WORKERS=3、
# SEL_GLOBAL_AI_CONCURRENCY=1、SEL_GLOBAL_IMAGE_CONCURRENCY=1，然后才重启。
# 应用层 RSS 准入按 SEL_SERVICE_MEMORY_MIB / SEL_RSS_ADMISSION_MIB 计算，不再是固定 768MiB，也不等于这里的内核上限。
MemoryMax=4G
MemoryLimit=4G
CPUQuota=300%

# 进程退出即重启；固定 5s 间隔（systemd 自带 StartLimit 防快连环重启）。
Restart=on-failure
RestartSec=5s

# 工作目录（专用用户私有；数据目录在 SEL_MOBILE_DATA_DIR 里指这里）。
WorkingDirectory=/var/lib/super-error-log/

# 日志走 journald（其自身限流兜底）。
SyslogIdentifier=super-error-log

[Install]
WantedBy=multi-user.target
