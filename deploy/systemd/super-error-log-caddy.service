# Super Error Log 的 Caddy 443 入口（study.pccoding666.com）
# 目标机：广州 ECS，Caddy >= 2.10；本单元由 deploy/README.md §4 安装。
# 改本文件后：systemctl daemon-reload && systemctl restart super-error-log-caddy
# （Caddyfile 里 admin off：caddy reload 走 admin API 不可用，改配置一律 restart 本服务。）

[Unit]
Description=Caddy 443 entry for study.pccoding666.com (Super Error Log)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/caddy run --config /opt/super-error-log/current/deploy/caddy/Caddyfile
Restart=on-failure
RestartSec=5s
# 443 绑定能力：setcap 文件能力会被 NoNewPrivileges 抑制（实测踩坑），
# 必须由 systemd 在 exec 前注入环境能力——两行同时存在才生效：
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

# 证书存储：独立私有目录，不嵌套在应用数据目录（/var/lib/super-error-log）内——
# 应用每次启动会把自身数据目录强制 chmod 0700（store.ts/pairing.ts），
# 嵌套会导致 caddy 无法穿越父目录读取证书（实测踩坑：open key: permission denied）。
# 本目录由 caddy 用户私有（0700），与应用数据目录平级、互不穿越。
Environment=XDG_DATA_HOME=/var/lib/caddy-super-error-log
ReadWritePaths=/var/lib/caddy-super-error-log
User=caddy
Group=caddy

[Install]
WantedBy=multi-user.target
